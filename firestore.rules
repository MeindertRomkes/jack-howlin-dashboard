rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default: only owner can read/write everything
    match /{document=**} {
      allow read, write: if request.auth != null && request.auth.token.email == 'romkesmeindert@gmail.com';
    }

    match /jack_core_set/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.email == 'romkesmeindert@gmail.com';
    }
    match /suno_tracks/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.email == 'romkesmeindert@gmail.com';
    }
    match /kie_jobs/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /media_library/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    // Analytics & intelligence — owner read/write (reads happen client-side after login)
    match /analytics_snapshots/{docId} {
      allow read, write: if request.auth != null && request.auth.token.email == 'romkesmeindert@gmail.com';
    }
    match /system/{docId} {
      allow read, write: if request.auth != null && request.auth.token.email == 'romkesmeindert@gmail.com';
    }
  }
}

